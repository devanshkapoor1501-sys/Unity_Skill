{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "asset_id": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?![\\s\\S])"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 50
          }
        },
        "detail": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "wall_thickness_m": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 2
        },
        "max_polygons": {
          "type": "integer",
          "minimum": 500,
          "maximum": 100000
        },
        "lod_ratio": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.8
        }
      },
      "required": [
        "size_m"
      ]
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?![\\s\\S])"
          },
          "primitive": {
            "enum": [
              "box",
              "cylinder",
              "sphere",
              "curve",
              "grid"
            ]
          },
          "size_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 50
            }
          },
          "location": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            }
          },
          "rotation_deg": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "material_id": {
            "enum": [
              "base",
              "trim",
              "accent"
            ]
          },
          "export": {
            "type": "boolean"
          },
          "modifiers": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "bevel"
                    },
                    "width_m": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 2
                    },
                    "segments": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    }
                  },
                  "required": [
                    "type",
                    "width_m",
                    "segments"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "subdivision"
                    },
                    "levels": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2
                    }
                  },
                  "required": [
                    "type",
                    "levels"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "mirror"
                    },
                    "axis": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2
                    }
                  },
                  "required": [
                    "type",
                    "axis"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "solidify"
                    },
                    "thickness_m": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 2
                    }
                  },
                  "required": [
                    "type",
                    "thickness_m"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "boolean"
                    },
                    "target": {
                      "type": "string",
                      "maxLength": 48,
                      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?![\\s\\S])"
                    },
                    "operation": {
                      "enum": [
                        "DIFFERENCE",
                        "UNION"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "target",
                    "operation"
                  ]
                }
              ]
            }
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              }
            }
          },
          "bevel_m": {
            "type": "number",
            "minimum": 0.0001,
            "maximum": 1
          },
          "detail": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        },
        "required": [
          "id",
          "primitive",
          "size_m",
          "location",
          "rotation_deg",
          "material_id",
          "export",
          "modifiers"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "primitive": {
                  "const": "curve"
                }
              }
            },
            "then": {
              "required": [
                "points",
                "bevel_m"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "points"
                    ]
                  },
                  {
                    "required": [
                      "bevel_m"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "primitive": {
                  "const": "grid"
                }
              }
            },
            "then": {},
            "else": {
              "not": {
                "required": [
                  "detail"
                ]
              }
            }
          }
        ]
      }
    },
    "sockets": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?![\\s\\S])"
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            }
          }
        },
        "required": [
          "id",
          "position"
        ]
      }
    },
    "overlap_policy": {
      "enum": [
        "ASSEMBLY_CONTACTS",
        "DISALLOW"
      ]
    },
    "expected_bounds": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "parameters"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:polyforge:modeling-request:1.0.0"
}
