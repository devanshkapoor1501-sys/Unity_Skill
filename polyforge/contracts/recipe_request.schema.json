{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:polyforge:recipe-request:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "asset_id": {
      "$ref": "#/$defs/id"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_m"
      ],
      "properties": {
        "size_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          }
        },
        "opening_width_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "opening_height_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "max_polygons": {
      "type": "integer",
      "minimum": 4,
      "maximum": 100000
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?![\\s\\S])"
    }
  }
}
