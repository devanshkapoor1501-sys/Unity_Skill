{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "task_class": {
      "enum": [
        "EXPLAIN",
        "INSPECT",
        "CREATE_ASSET",
        "ANIMATE",
        "FIX_PROJECT",
        "ADD_MECHANIC",
        "BUILD_GAME"
      ]
    },
    "domain_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "blender",
          "unity",
          "animation",
          "gameplay",
          "inspection",
          "2d",
          "materials",
          "assets"
        ]
      }
    },
    "feature_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      }
    },
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "input": {
      "type": "object"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "budget_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_cpu_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "min_free_disk_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "min_available_ram_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gpu_required": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "brief",
    "task_class",
    "domain_tags",
    "feature_ids"
  ]
}
