{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "role_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      }
    },
    "stage": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ]
    },
    "budget_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "write_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "feature_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      }
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "role_id",
    "capability_id",
    "depends_on",
    "stage",
    "budget_seconds",
    "write_root",
    "feature_ids"
  ]
}
