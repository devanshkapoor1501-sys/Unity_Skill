{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "reviewer_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "verdict": {
      "enum": [
        "APPROVED",
        "REJECTED",
        "REVIEW",
        "BLOCKED"
      ]
    },
    "independence": {
      "const": "DIFFERENT_ROLE_SAME_HOST"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "request": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "candidate_digest",
    "producer_id",
    "reviewer_id",
    "verdict",
    "independence",
    "evidence"
  ]
}
