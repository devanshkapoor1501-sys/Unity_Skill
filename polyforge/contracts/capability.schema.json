{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:polyforge:capability:1.0.0",
  "title": "Versioned capability descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "input_schema",
    "runner",
    "deterministic",
    "requires",
    "tests",
    "output_types",
    "trust_requirement"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "input_schema": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.schema\\.json(?![\\s\\S])"
    },
    "runner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+(?![\\s\\S])"
    },
    "deterministic": {
      "type": "boolean"
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trust_requirement": {
      "enum": [
        "TRUSTED_LOCAL",
        "SANDBOXED_UNTRUSTED"
      ]
    }
  }
}
