{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "knowledge_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "concept": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "when_to_use": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "reference_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "retrieved_or_verified_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "output_contract": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "api_probe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "domain": {
      "enum": [
        "blender",
        "unity",
        "game_design",
        "workforce",
        "quality",
        "security"
      ]
    },
    "intent_triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "pitfalls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "security_notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "license_or_attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "uri",
          "license_or_attribution"
        ]
      }
    },
    "doc_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reference_path": {
      "type": "string",
      "pattern": "^references/(blender|unity|game_design|workforce|quality|security)/[a-z0-9-]+\\.md$"
    },
    "knowledge_state": {
      "enum": [
        "REFERENCE_ONLY",
        "VERSION_PROBED",
        "EXPERIMENTAL",
        "VERIFIED_IN_WORKFLOW",
        "UNAVAILABLE"
      ]
    },
    "support_state": {
      "enum": [
        "VERIFIED_EXECUTABLE",
        "SUPPORTED_ASSISTED",
        "REFERENCE_ONLY",
        "EXPERIMENTAL",
        "UNSUPPORTED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "capability_ids": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "content_kind": {
      "const": "CURATED_SUMMARY"
    }
  },
  "required": [
    "knowledge_id",
    "concept",
    "topic",
    "when_to_use",
    "reference_text",
    "retrieved_or_verified_at",
    "reviewer",
    "output_contract",
    "api_probe_id",
    "schema_version",
    "domain",
    "intent_triggers",
    "alternatives",
    "prerequisites",
    "examples",
    "pitfalls",
    "security_notes",
    "versions",
    "sources",
    "doc_digest",
    "reference_path",
    "knowledge_state",
    "support_state",
    "confidence",
    "capability_ids",
    "content_kind"
  ]
}
