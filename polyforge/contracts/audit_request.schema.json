{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:polyforge:audit-request:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "asset_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?![\\s\\S])"
    }
  }
}
