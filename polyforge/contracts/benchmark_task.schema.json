{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:polyforge:benchmark-task:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "original_brief_sha256",
    "task_success_schema",
    "ownership",
    "rubric_sha256",
    "budgets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
    },
    "task_type": {
      "enum": [
        "ASSET",
        "ANIMATION_IMPORT",
        "GAME_MECHANIC",
        "CROSS_ENGINE_REPAIR",
        "COMPLETE_GAME_2D",
        "COMPLETE_GAME_3D"
      ]
    },
    "original_brief_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "task_success_schema": {
      "type": "string",
      "minLength": 1
    },
    "ownership": {
      "enum": [
        "DEV_FIXTURE",
        "EVALUATOR_REFERENCE"
      ]
    },
    "rubric_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "tool_calls",
        "tokens",
        "retries"
      ],
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    }
  }
}
