{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "brief_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task": {
      "type": "object"
    },
    "technical": {
      "enum": [
        "APPROVED",
        "REJECTED",
        "REVIEW",
        "BLOCKED",
        "NOT_RUN",
        "NOT_REQUIRED"
      ]
    },
    "subjective": {
      "enum": [
        "APPROVED",
        "REJECTED",
        "REVIEW",
        "BLOCKED",
        "NOT_RUN",
        "NOT_REQUIRED"
      ]
    },
    "human_review": {
      "type": [
        "object",
        "null"
      ]
    },
    "acceptance": {
      "type": [
        "object",
        "null"
      ]
    },
    "gameplay": {
      "enum": [
        "PUBLIC_CHECKS_ONLY",
        "NOT_REQUIRED"
      ]
    },
    "game_status": {
      "const": "PARTIAL"
    },
    "promotion": {
      "enum": [
        "APPROVED",
        "REJECTED",
        "REVIEW",
        "BLOCKED",
        "NOT_RUN",
        "NOT_REQUIRED"
      ]
    },
    "inspectors": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "authored_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reviewed_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evaluator_owner": {
            "const": "PUBLIC_DEVELOPMENT"
          },
          "tool_identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "writable_paths": {
            "type": "array",
            "maxItems": 0
          },
          "readable_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "status": {
            "enum": [
              "APPROVED",
              "REJECTED",
              "REVIEW",
              "BLOCKED",
              "NOT_RUN",
              "NOT_REQUIRED"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "authored_by",
          "reviewed_by",
          "evaluator_owner",
          "tool_identity",
          "writable_paths",
          "readable_paths",
          "status",
          "required"
        ]
      }
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "independence": {
      "const": "DIFFERENT_ROLE_SAME_HOST"
    },
    "evaluator_owner": {
      "const": "EXTERNAL_NOT_SUPPLIED"
    },
    "isolation_verified": {
      "const": false
    },
    "unresolved_risks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "amendment_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_review": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "candidate_digest",
    "revision",
    "brief_digest",
    "task",
    "technical",
    "subjective",
    "human_review",
    "acceptance",
    "gameplay",
    "game_status",
    "promotion",
    "inspectors",
    "evidence_digest",
    "independence",
    "evaluator_owner",
    "isolation_verified",
    "unresolved_risks",
    "amendment_digest",
    "source_review"
  ]
}
